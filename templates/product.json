{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title"
        },
        "price": {
          "type": "price"
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector"
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description"
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "trust": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<ul class=\"flair-trust\">\n  <li>Stainless steel. Won't rust or turn your skin green.</li>\n  <li>Tracked delivery to UK addresses.</li>\n  <li>14-day returns from the day it arrives.</li>\n</ul>"
          }
        },
        "tab_delivery": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Delivery",
            "icon": "truck",
            "content": "<p>We ship to UK addresses with tracking on every order. You get the tracking link by email as soon as your order is dispatched, and the estimated delivery window is shown at checkout.</p><p><a href=\"/pages/delivery\">Read the delivery policy</a></p>",
            "page": ""
          }
        },
        "tab_returns": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Returns",
            "icon": "return",
            "content": "<p>Changed your mind? Tell us within 14 days of delivery and send the item back unworn in its original packaging for a refund. For hygiene reasons, pierced earrings can't be returned once taken out of their sealed packaging, unless they are faulty.</p><p><a href=\"/pages/returns\">Read the full returns policy</a></p>",
            "page": ""
          }
        },
        "tab_care": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Care",
            "icon": "check_mark",
            "content": "<p>Stainless steel is made for everyday wear, water included. To keep the shine, wipe it with a soft cloth and keep it away from bleach and chlorine.</p>",
            "page": ""
          }
        }
      },
      "block_order": [
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "trust",
        "description",
        "tab_delivery",
        "tab_returns",
        "tab_care",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_position": "left",
        "gallery_layout": "thumbnail_slider",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "cover",
        "image_zoom": "lightbox",
        "mobile_thumbnails": "show",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You may also like",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "columns_mobile": "2",
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}