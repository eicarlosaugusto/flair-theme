{%- comment -%}
  Flair: the proof (page peak). A pinned scene: one real piece stays on screen
  while the backdrop word changes, and the shine sweeps it again at every step.
{%- endcomment -%}
{%- liquid
  assign steps = section.blocks | where: 'type', 'step'
  assign step_count = steps.size | at_least: 1 | at_most: 5
  assign scene_height = step_count | at_least: 2
  assign piece = section.settings.product
  assign piece_image = section.settings.image | default: piece.featured_media.preview_image
-%}
<section
  class="flair-proof color-{{ section.settings.color_scheme }}"
  aria-labelledby="FlairProof-{{ section.id }}"
  data-fx-fixa
  data-fx-altura="{{ scene_height }}"
  data-fx-etapas="{{ step_count }}"
  data-etapa="1"
  style="--flair-steps: {{ step_count }};"
>
  <div class="fx-palco flair-proof__stage">
    <h2 id="FlairProof-{{ section.id }}" class="flair-proof__intro flair-eyebrow">
      {{- section.settings.heading | escape -}}
    </h2>

    <div class="flair-proof__words" aria-hidden="true">
      {%- for block in steps limit: 5 -%}
        <span class="flair-proof__word" style="--i: {{ forloop.index }};">{{ block.settings.word | escape }}</span>
      {%- endfor -%}
    </div>

    <figure class="flair-proof__piece flair-plate flair-shine flair-shine--scene">
      {%- if piece_image != blank -%}
        {{
          piece_image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            sizes: '(min-width: 990px) 34vw, 70vw',
            widths: '400, 600, 800, 1000',
            alt: piece.title
        }}
      {%- else -%}
        {{ 'product-apparel-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </figure>

    <ol class="flair-proof__steps">
      {%- for block in steps limit: 5 -%}
        <li class="fx-etapa flair-proof__step" {{ block.shopify_attributes }}>
          <span class="flair-proof__step-word">{{ block.settings.word | escape }}</span>
          <span class="flair-proof__step-line">{{ block.settings.line | escape }}</span>
        </li>
      {%- endfor -%}
    </ol>

    <div class="flair-proof__meter" aria-hidden="true"><span></span></div>

    {%- if piece != blank -%}
      <a class="flair-proof__link link" href="{{ piece.url }}">
        {{- piece.title | escape }} · {{ piece.price | money -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Flair · Proof",
  "tag": "div",
  "class": "section flair-section",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear it everywhere"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Piece",
      "info": "Its main photo, name and price are used. Pick a product with a clean photo of the metal."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image override",
      "info": "Optional. Replaces the product photo."
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "text",
          "id": "word",
          "label": "Word",
          "default": "Shower"
        },
        {
          "type": "text",
          "id": "line",
          "label": "Line",
          "default": "Water doesn't touch the shine."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flair · Proof",
      "blocks": [
        { "type": "step", "settings": { "word": "Shower", "line": "Waterproof, so the shine stays." } },
        { "type": "step", "settings": { "word": "Gym", "line": "Built for sweat. Made not to turn green." } },
        { "type": "step", "settings": { "word": "Rain", "line": "British weather, handled." } },
        { "type": "step", "settings": { "word": "Every day", "line": "Waterproof. Tarnish-resistant. Made to stay on." } }
      ]
    }
  ]
}
{% endschema %}
