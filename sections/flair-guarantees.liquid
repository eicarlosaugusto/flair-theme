{%- comment -%}
  Flair: guarantees. A quiet band, no effects: the breath after the showcase.
{%- endcomment -%}
<section class="flair-guarantees color-{{ section.settings.color_scheme }}" aria-label="{{ section.settings.label | escape }}">
  <ul class="flair-guarantees__list page-width" role="list">
    {%- for block in section.blocks -%}
      <li class="flair-guarantees__item" {{ block.shopify_attributes }}>
        {%- if block.settings.link != blank -%}
          <a href="{{ block.settings.link }}" class="flair-guarantees__title">{{ block.settings.title | escape }}</a>
        {%- else -%}
          <span class="flair-guarantees__title">{{ block.settings.title | escape }}</span>
        {%- endif -%}
        <span class="flair-guarantees__text">{{ block.settings.text | escape }}</span>
      </li>
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Flair · Guarantees",
  "tag": "div",
  "class": "section flair-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "Why shop with Flair"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-2"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Guarantee",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Tracked UK delivery" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free on orders over £35." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Flair · Guarantees",
      "blocks": [
        { "type": "item", "settings": { "title": "Tracked UK delivery", "text": "Free on orders over £35." } },
        { "type": "item", "settings": { "title": "14-day returns", "text": "From the day it arrives." } },
        { "type": "item", "settings": { "title": "VAT included", "text": "The price you see is the price you pay." } },
        { "type": "item", "settings": { "title": "Secure checkout", "text": "Encrypted checkout powered by Shopify." } }
      ]
    }
  ]
}
{% endschema %}
