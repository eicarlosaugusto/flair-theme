{%- comment -%}
  Flair: night opening. Huge type anchored bottom-left, one piece lit in a frame on the right.
{%- endcomment -%}
<section class="flair-hero color-{{ section.settings.color_scheme }}" aria-labelledby="FlairHero-{{ section.id }}">
  <div class="flair-hero__inner page-width">
    <div class="flair-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="flair-eyebrow" data-fx="surgir">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h1 id="FlairHero-{{ section.id }}" class="flair-hero__title" data-fx="palavras">
        {{- section.settings.heading | escape -}}
      </h1>
      {%- if section.settings.text != blank -%}
        <div class="flair-hero__text" data-fx="subir" data-fx-atraso="500">{{ section.settings.text }}</div>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a
          class="button flair-hero__cta"
          href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
          data-fx="subir"
          data-fx-atraso="700"
        >
          {{- section.settings.button_label | escape -}}
        </a>
      {%- endif -%}
    </div>

    <figure class="flair-hero__media flair-plate flair-shine" data-fx="crescer" data-fx-duracao="1400">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1400
          | image_tag:
            loading: 'eager',
            fetchpriority: 'high',
            sizes: '(min-width: 990px) 42vw, 90vw',
            widths: '400, 600, 800, 1000, 1400',
            alt: section.settings.image.alt
        }}
      {%- else -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Flair · Opening",
  "tag": "div",
  "class": "section flair-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Piece image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Everyday jewellery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Steel that keeps its shine."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Chains, rings and hoops made for everyday wear. Waterproof, won't tarnish, built to layer.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-3"
    }
  ],
  "presets": [
    {
      "name": "Flair · Opening"
    }
  ]
}
{% endschema %}
